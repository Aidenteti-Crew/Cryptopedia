# apps/api/.env 예시 — 이 파일을 .env 로 복사해서 채워요. 비밀 값은 채팅·PR 말고 안전한 곳으로 주고받아요.

# ── 실행 환경 ─────────────────────────────────────────────────
ENVIRONMENT=local          # config.ts 에서 고르는 설정 묶음: local · staging · production
PORT=4000                  # API 가 뜨는 포트
NODE_ENV=development       # production 이면 로그인 쿠키에 Secure 가 붙어요

# ── DB · Redis (로컬 Docker) ──────────────────────────────────
# ⚠️ 공유 Supabase(프로덕션) 주소를 넣지 마세요. 여기서 하는 쓰기가 바로 프로덕션에 반영돼요.
LOCAL_DB_HOST=127.0.0.1    # 로컬 Postgres 컨테이너(chainery-postgres)
LOCAL_DB_PORT=15432
LOCAL_DB_USER=cherry
LOCAL_DB_PASSWORD=cherry_dev   # 로컬 컨테이너 전용 기본값
LOCAL_DB_NAME=cherry_db
DB_SSL=false               # 관리형 PG(Supabase 등)에 붙을 때만 true
# Redis 포트는 config.ts 에 16379 로 고정돼 있어요(로그인 refresh 토큰 저장)
LOCAL_REDIS_HOST=127.0.0.1

# ── 웹 ↔ API 주소 ────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000       # API 를 부를 수 있는 웹 주소, 쉼표로 여러 개
FRONTEND_URL=http://localhost:3000       # 로그인·가입 메일 링크가 열릴 웹 주소
LOCAL_WEB_ENDPOINT=http://localhost:3000 # 예전 인증 메일(검증·비밀번호 재설정) 링크용 웹 주소
PUBLIC_API_URL=http://localhost:4000     # 외부(에이전트·A2A)에 알려 줄 API 주소

# ── 로그인 ───────────────────────────────────────────────────
JWT_SECRET=                # 비밀. 로그인 토큰 서명 키 (openssl rand -hex 32)
GOOGLE_CLIENT_ID=          # Google 로그인 OAuth 클라이언트 ID. 웹의 NEXT_PUBLIC_GOOGLE_CLIENT_ID 와 같은 값

# ── 메일 (Resend) — 이메일 링크 로그인·회원가입 메일 ─────────────
RESEND_API_KEY=            # 비밀. Resend 대시보드 → API Keys (Sending access 면 충분)
RESEND_FROM_EMAIL=         # 보내는 주소. Resend 에서 검증한 도메인의 주소(no-reply@<도메인>)
                           # 도메인 검증 전 시험: onboarding@resend.dev (Resend 계정 주인에게만 발송됨)

# ── 벤치마크 ─────────────────────────────────────────────────
BENCH_KEY_SECRET=          # 비밀. 회원 Anthropic 키 암호화 키(64 hex). ⚠️ 한 번 정하면 절대 바꾸지 마세요(로컬·프로덕션 동일)
BENCH_LLM_PROVIDER=claude  # 벤치마크에 쓸 LLM: claude · openai

# ── LLM 키 (쓰는 기능이 있을 때만) ──────────────────────────────
ANTHROPIC_API_KEY=         # 비밀. 벤치마크·제출 자료 분석
OPENAI_API_KEY=            # 비밀. KaaS 질의·벤치(openai 일 때)

# ── 기능 스위치 ──────────────────────────────────────────────
SCHEDULER_ENABLED=false            # true 면 기사 수집 크론이 돌아요. 로컬은 false 유지
SUBMISSION_ANALYSIS_ENABLED=false  # false 면 제출 자료 LLM 분석을 건너뛰어요
CHAIN_ADAPTER=mock                 # KaaS 출처 기록 체인: mock · status · near
DEMO_FALLBACK=                     # true 면 CHAIN_ADAPTER 와 상관없이 mock 사용(데모용)

# ── 파일 저장 위치 ────────────────────────────────────────────
UPLOAD_DIR=./.uploads      # 제출 파일 저장 폴더. 서버에선 볼륨 경로로
DATA_DIR=./storage         # 프레임워크 지형도 데이터 폴더
