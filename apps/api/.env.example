# ── Local (self-hosted) ─────────────────────────────────────────
ENVIRONMENT=local
PORT=4000
NODE_ENV=development

# DB — docker-compose postgres (host port 15432)
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=15432
LOCAL_DB_USER=cherry
LOCAL_DB_PASSWORD=cherry_dev
LOCAL_DB_NAME=cherry_db
# Redis: config.ts 가 127.0.0.1:16379 하드코딩 (docker-compose REDIS_PORT 기본값과 일치)
LOCAL_REDIS_HOST=127.0.0.1
LOCAL_WEB_ENDPOINT=http://localhost:3000

# Web ↔ API
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Auth
JWT_SECRET=   # openssl rand -hex 32
GOOGLE_CLIENT_ID=

# Bench — 회원 Anthropic 키 암호화 키 (64 hex). 서버 배포 시에도 같은 값 유지
BENCH_KEY_SECRET=   # openssl rand -hex 32
BENCH_LLM_PROVIDER=claude

# LLM / 외부 서비스 (필요할 때 채움)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Feature flags
SCHEDULER_ENABLED=false
SUBMISSION_ANALYSIS_ENABLED=false
CHAIN_ADAPTER=mock
DEMO_FALLBACK=

# Storage
UPLOAD_DIR=./.uploads
DATA_DIR=./storage

# DB SSL — 관리형 PG(Supabase 등)일 때만 true
DB_SSL=false
