# apps/web/.env.local 예시 — 이 파일을 .env.local 로 복사해서 채워요.
# NEXT_PUBLIC_* 는 빌드할 때 값이 박혀요. 바꾸면 dev 서버 재시작, 배포는 web 재빌드가 필요해요.

# API 주소. 비워 두면 로그인·계정은 http://localhost:4000 을 부르고,
# 행사·소식 같은 LIVE 화면은 API 대신 public/cryptopedia/live/*.json 스냅샷을 읽어요.
NEXT_PUBLIC_API_URL=

# Google 로그인 버튼용 OAuth 클라이언트 ID. API 의 GOOGLE_CLIENT_ID 와 같은 값
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# NEAR 지갑 연결에 쓰는 컨트랙트 ID (KaaS 화면에서만 필요, 비우면 tomatojams.testnet)
NEXT_PUBLIC_NEAR_CONTRACT_ID=
