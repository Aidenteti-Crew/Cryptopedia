# Cherry in the Haystack — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env to version control.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Connection URL for the PostgreSQL 16 + pgvector database.
# Local dev default matches docker-compose.yml service.
DATABASE_URL=postgresql://cherry:cherry_dev@localhost:5432/cherry_db

# ── Notion ───────────────────────────────────────────────────────────────────
# Notion Integration Token — create an integration at https://www.notion.so/my-integrations
NOTION_API_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic (Claude) ───────────────────────────────────────────────────────
# API key for Claude models — obtain at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── GitHub ───────────────────────────────────────────────────────────────────
# GitHub App installation token (preferred) or fine-grained PAT.
# Required in production for ACP polling (contents:read) and generated-crawler PRs
# (metadata:read, contents:write, pull_requests:write).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO_OWNER=Aidenteti-Crew
GITHUB_REPO_NAME=Cryptopedia
GITHUB_BASE_BRANCH=hansu-crawl

# ── Browser-use crawler analysis ─────────────────────────────────────────────
# Analysis is disabled until an explicit exact-host allowlist is configured.
CRAWLER_ANALYSIS_ALLOWED_HOSTS=build.avax.network
CRAWLER_ANALYSIS_TIMEOUT_SECONDS=300
CRAWLER_ANALYSIS_API_TOKEN=replace-with-a-long-random-service-token

# ── Apify (X accounts and web sources) ───────────────────────────────────────
# Personal API token from https://console.apify.com → Settings → API & Integrations.
# The free plan has a $5 monthly cap; each actor run costs at least ~$0.004.
APIFY_TOKEN=

# ── X (Twitter) official API — optional, not used by the default sources.yaml ──
# New developers get pay-per-use pricing (about $0.005 per post read); the old Free/Basic tiers
# are gone. Only needed if a source is switched back to adapter X_API.
X_BEARER_TOKEN=

# ── LLM classification/scoring (OpenAI-compatible, e.g. NVIDIA build.nvidia.com) ──
# NVIDIA's free tier is for development/prototyping (~40 requests/minute). Get a key at
# https://build.nvidia.com (model page -> Get API Key). Run with: pnpm --filter @cryptopedia/pipeline classify
# Reasoning models answer in 20-30 s per request; classify runs 4 requests in parallel.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/deepseek-v4.1-flash

# ── Slack ────────────────────────────────────────────────────────────────────
# Incoming Webhook URL for posting pipeline alerts to a Slack channel.
# Create at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Twitter / X ──────────────────────────────────────────────────────────────
# Bearer Token for the Twitter v2 API (read-only, for source monitoring).
# Obtain at https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAA%2FXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Reddit ───────────────────────────────────────────────────────────────────
# OAuth2 credentials for the Reddit API (read-only app).
# Register an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
REDDIT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Local Docker services (optional overrides) ───────────────────────────────
POSTGRES_USER=cherry
POSTGRES_PASSWORD=cherry_dev
POSTGRES_DB=cherry_db
